node_modules/
dist/
build/
.env
.env.local
*.log
.DS_Store
packages/db/generated/
apps/web/dev-dist/
coverage/
.vite/

# Certificados locais (ex: CA de antivirus/proxy corporativo para builds
# Docker atras de inspecao de HTTPS). Nunca commitar - especifico da maquina.
infra/certs/*.crt
infra/certs/*.pem

# Backups do banco: dados reais, nunca vao para o repositorio
backups/
*.sql.gz

# Permissoes locais do Claude Code: especificas da maquina.
# O arquivo na raiz existe por engano historico - o lugar certo e .claude/.
.claude/settings.local.json
settings.local.json

# Cache incremental do TypeScript: muda a cada compilacao e nao diz nada a
# quem le o historico. Estava versionado por engano.
*.tsbuildinfo

# Sobra de redirecionamento do Windows ("> NUL" dentro do Git Bash cria um
# arquivo de verdade chamado NUL, em vez de descartar a saida).
NUL
