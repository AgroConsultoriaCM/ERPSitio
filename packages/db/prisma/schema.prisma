generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Acesso e propriedade
// ---------------------------------------------------------------------------

enum RolePapel {
  ADMIN
  GERENTE
  ENCARREGADO
}

model Propriedade {
  id        String   @id @default(uuid())
  nome      String
  localizacao String?
  latitude  Float?
  longitude Float?
  poligono  Json?
  /// CNPJ ou CPF do produtor. Usado para avisar quando uma nota importada foi
  /// emitida para outra pessoa - nota de vizinho que caiu no mesmo e-mail.
  documento String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios              Usuario[]
  culturas              Cultura[]
  talhoes               Talhao[]
  tiposAtividade        TipoAtividade[]
  atividades            Atividade[]
  insumos               Insumo[]
  movimentacoesEstoque  MovimentacaoEstoque[]
  colheitas             Colheita[]
  perfisCorrecaoSolo    PerfilCorrecaoSolo[]
  analisesSolo          AnaliseSolo[]
  analisesFoliar        AnaliseFoliar[]
  setoresIrrigacao      SetorIrrigacao[]
  gruposTalhao          GrupoTalhao[]
  executores            Executor[]
  lotesInsumo           LoteInsumo[]
  regrasAlerta          RegraAlerta[]
  irrigacoes            Irrigacao[]
  permissoes            PermissaoPapel[]
  notasEntrada          NotaFiscalEntrada[]
  mapeamentosProduto    MapeamentoProdutoNota[]
  leiturasSatelite      LeituraSatelite[]
  laudosImportados      LaudoImportado[]
  analisesFisicas       AnaliseFisicaSolo[]
  lotesComposto         LoteComposto[]
  analisesComposto      AnaliseComposto[]
}

// Permissao de um papel sobre um modulo do sistema. Quando nao ha linha
// gravada, vale o padrao definido em apps/api/src/services/permissoes.ts.
// ADMIN nunca e limitado (evita o admin se trancar para fora).
model PermissaoPapel {
  id            String   @id @default(uuid())
  papel         RolePapel
  modulo        String
  podeVer       Boolean  @default(false)
  podeEditar    Boolean  @default(false)
  propriedadeId String
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([propriedadeId, papel, modulo])
  @@index([propriedadeId])
}

model Usuario {
  id           String    @id @default(uuid())
  nome         String
  email        String    @unique
  senhaHash    String
  role         RolePapel
  ativo        Boolean   @default(true)
  propriedadeId String
  propriedade  Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  atividadesResponsavel Atividade[]      @relation("AtividadeResponsavel")
  irrigacoes            Irrigacao[]      @relation("IrrigacaoResponsavel")
  refreshTokens         RefreshToken[]
  notasImportadas       NotaFiscalEntrada[] @relation("NotaImportadaPor")
  laudosImportados      LaudoImportado[]    @relation("LaudoImportadoPor")

  @@index([propriedadeId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

// ---------------------------------------------------------------------------
// Cadastros base: culturas, talhoes, safras
// ---------------------------------------------------------------------------

model Cultura {
  id            String   @id @default(uuid())
  nome          String
  variedade     String?

  // Peso da caixa de referencia usada na venda, em quilos.
  //
  // E o que diz em que unidade o preco da colheita e digitado:
  //   preenchido (limao taiti, 27,2) -> o preco lancado e POR CAIXA e o
  //     sistema converte para o quilo dividindo por este numero
  //   vazio (abacate)                -> o preco lancado ja e POR QUILO
  //
  // Fica na cultura, e nao numa constante do codigo, porque a mesma
  // propriedade vende limao por caixa e abacate por quilo.
  pesoCaixaKg   Float?
  propriedadeId String
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  talhoes             Talhao[]
  perfisCorrecaoSolo  PerfilCorrecaoSolo[]

  @@index([propriedadeId])
}

enum StatusTalhao {
  EM_FORMACAO
  ATIVO
  INATIVO
}

model Talhao {
  id            String       @id @default(uuid())
  nome          String
  codigo        String?
  areaHa        Float?
  culturaId     String?
  cultura       Cultura?     @relation(fields: [culturaId], references: [id])
  dataPlantio   DateTime?
  // Espacamento do plantio em metros. Combinado com areaHa permite estimar
  // o numero de plantas do talhao.
  espacamentoEntrePlantas Float?
  espacamentoEntreLinhas  Float?
  status        StatusTalhao @default(ATIVO)
  poligono      Json?
  corMapa       String?
  propriedadeId String
  propriedade   Propriedade  @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  safras          Safra[]
  colheitas       Colheita[]
  analisesSolo    AnaliseSolo[]
  analisesFoliar  AnaliseFoliar[]
  gruposItens     GrupoTalhaoItem[]
  atividadesItens AtividadeTalhao[]
  leiturasSatelite LeituraSatelite[]
  analisesFisicas  AnaliseFisicaSolo[]
  amostrasLaudo    AmostraLaudo[]

  @@index([propriedadeId])
  @@index([culturaId])
}

// ---------------------------------------------------------------------------
// Grupos de talhoes: atalho para lancar operacoes em varios talhoes de uma
// vez ("Limao Novo", "Abacate"). Um talhao pode estar em varios grupos.
// ---------------------------------------------------------------------------

model GrupoTalhao {
  id            String   @id @default(uuid())
  nome          String
  corMapa       String?
  observacoes   String?
  propriedadeId String
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  itens GrupoTalhaoItem[]

  @@index([propriedadeId])
}

model GrupoTalhaoItem {
  id       String @id @default(uuid())
  grupoId  String
  grupo    GrupoTalhao @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  talhaoId String
  talhao   Talhao @relation(fields: [talhaoId], references: [id], onDelete: Cascade)

  @@unique([grupoId, talhaoId])
  @@index([grupoId])
  @@index([talhaoId])
}

// ---------------------------------------------------------------------------
// Executores: quem realiza o servico. Cadastro reutilizavel para nao redigitar
// nome de empreiteiro e permitir relatorio de custo por prestador.
// ---------------------------------------------------------------------------

enum TipoExecutor {
  EQUIPE_PROPRIA
  EMPREITEIRO
  PRESTADOR_SERVICO
}

model Executor {
  id            String   @id @default(uuid())
  nome          String
  tipo          TipoExecutor
  contato       String?
  observacoes   String?
  ativo         Boolean  @default(true)
  propriedadeId String
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  atividades Atividade[]
  colheitas  Colheita[]

  @@index([propriedadeId])
}

// Setores de irrigacao: camada independente dos talhoes (um setor pode
// cruzar varios talhoes e vice-versa), mas tambem obrigatoriamente contido
// no poligono da propriedade. Base para o manejo hidrico.
model SetorIrrigacao {
  id            String   @id @default(uuid())
  nome          String
  codigo        String?
  areaHa        Float?
  poligono      Json?
  corMapa       String?
  observacoes   String?
  propriedadeId String
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  irrigacoes Irrigacao[]

  @@index([propriedadeId])
}

model Safra {
  id            String   @id @default(uuid())
  nome          String
  talhaoId      String
  talhao        Talhao   @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  dataInicio    DateTime
  dataFim       DateTime?
  observacoes   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  atividades  Atividade[]
  colheitas   Colheita[]

  @@index([talhaoId])
}

// ---------------------------------------------------------------------------
// Atividades de campo (apontamentos do encarregado)
// ---------------------------------------------------------------------------

model TipoAtividade {
  id            String   @id @default(uuid())
  nome          String
  descricao     String?
  propriedadeId String
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  atividades  Atividade[]

  @@index([propriedadeId])
}

enum OrigemLancamento {
  WEB
  APP
}

// Operacao de campo (poda, desbrota, pulverizacao, fertirrigacao...).
// Chamada de "Operacao" na interface; o nome Atividade permanece no banco
// porque o app de campo e a fila offline ja dependem dele.
model Atividade {
  id              String   @id @default(uuid())
  clientId        String?  @unique
  data            DateTime
  observacoes     String?
  origem          OrigemLancamento @default(WEB)

  // Mao de obra: 0/nulo quando feita pela equipe propria; valor da diaria
  // (ou do servico) quando terceirizada. Rateado entre os talhoes por area.
  custoMaoDeObra  Float?

  propriedadeId   String
  propriedade     Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  tipoAtividadeId String
  tipoAtividade   TipoAtividade @relation(fields: [tipoAtividadeId], references: [id])
  executorId      String?
  executor        Executor? @relation(fields: [executorId], references: [id])
  safraId         String?
  safra           Safra?   @relation(fields: [safraId], references: [id])
  responsavelId   String
  responsavel     Usuario  @relation("AtividadeResponsavel", fields: [responsavelId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  talhoes               AtividadeTalhao[]
  insumos               AtividadeInsumo[]
  movimentacoesEstoque  MovimentacaoEstoque[]

  @@index([propriedadeId])
  @@index([data])
  @@index([executorId])
}

// Talhoes cobertos por uma operacao. areaHa e custoRateado sao gravados no
// momento do lancamento (snapshot) para o historico de custo nao mudar se o
// talhao for redesenhado depois.
model AtividadeTalhao {
  id           String @id @default(uuid())
  atividadeId  String
  atividade    Atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  talhaoId     String
  talhao       Talhao @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  areaHa       Float?
  custoRateado Float?

  @@unique([atividadeId, talhaoId])
  @@index([atividadeId])
  @@index([talhaoId])
}

// Produto usado numa operacao. Na pulverizacao o encarregado declara o que
// LEVOU e o que DEVOLVEU; o usado (quantidade) e a diferenca, e o custo vem
// do preco do lote de onde saiu.
model AtividadeInsumo {
  id                   String   @id @default(uuid())
  atividadeId          String
  atividade            Atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  insumoId             String
  insumo               Insumo   @relation(fields: [insumoId], references: [id])
  quantidade           Float
  quantidadeLevada     Float?
  quantidadeRetornada  Float?
  unidade              String
  custoUnitario        Float?
  custoTotal           Float?
  createdAt            DateTime @default(now())

  @@index([atividadeId])
  @@index([insumoId])
}

// ---------------------------------------------------------------------------
// Estoque de insumos
// ---------------------------------------------------------------------------

enum CategoriaInsumo {
  DEFENSIVO
  FERTILIZANTE
  EMBALAGEM
  OUTRO
}

// Funcao agronomica do produto - base do controle de pragas: permite saber
// "quando foi a ultima vez que este talhao levou herbicida".
enum FuncaoInsumo {
  INSETICIDA
  FUNGICIDA
  HERBICIDA
  ACARICIDA
  NEMATICIDA
  NUTRICAO_FOLIAR
  FERTILIZANTE_SOLO
  ADJUVANTE
  OUTRO
}

model Insumo {
  id             String   @id @default(uuid())
  nome           String
  categoria      CategoriaInsumo @default(OUTRO)

  /// Um produto pode ter mais de uma funcao - um mesmo defensivo age como
  /// fungicida e acaricida, por exemplo. Isso importa no controle de pragas:
  /// uma aplicacao zera o contador de TODAS as funcoes do produto.
  funcoes        FuncaoInsumo[]

  /// Litro ou quilo, nunca embalagem. E o que permite devolver ao estoque a
  /// sobra do galao depois da pulverizacao.
  unidadeMedida  String
  estoqueMinimo  Float?

  /// Dose de bula. A unidade acompanha a do produto: se o produto e medido em
  /// litros, a dose por 100 L esta em mL e a por hectare em L; se em quilos,
  /// em gramas e quilos. Guardar o numero puro evita campo de unidade que sai
  /// de sincronia com o produto.
  dosePor100L     Float?
  dosePorHectare  Float?
  observacoesDose String?

  /// Codigo do produto no catalogo do fabricante, quando vier da nota.
  fabricante     String?
  propriedadeId  String
  propriedade    Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  movimentacoes         MovimentacaoEstoque[]
  usosEmAtividades      AtividadeInsumo[]
  lotes                 LoteInsumo[]
  mapeamentosNota       MapeamentoProdutoNota[]
  lotesComposto         LoteComposto[]

  @@index([propriedadeId])
}

// Lote de entrada do produto no estoque - uma compra, o inventario inicial ou
// um ajuste. Guarda o preco pago, o que permite custo real por talhao (e nao
// custo medio chutado). "quantidadeRestante" e o saldo do lote.
enum OrigemLote {
  COMPRA
  INVENTARIO_INICIAL
  AJUSTE
}

model LoteInsumo {
  id                 String   @id @default(uuid())
  insumoId           String
  insumo             Insumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  origem             OrigemLote @default(COMPRA)
  data               DateTime
  quantidade         Float
  quantidadeRestante Float
  precoUnitario      Float
  fornecedor         String?
  numeroNota         String?
  observacoes        String?
  /// De qual nota este lote veio, quando veio de importacao de XML.
  notaFiscalId       String?
  notaFiscal         NotaFiscalEntrada? @relation(fields: [notaFiscalId], references: [id])
  propriedadeId      String
  propriedade        Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  movimentacoes MovimentacaoEstoque[]

  @@index([propriedadeId])
  @@index([insumoId])
  @@index([data])
  @@index([notaFiscalId])
}

enum TipoMovimentacaoEstoque {
  ENTRADA
  SAIDA
  AJUSTE
}

enum OrigemMovimentacaoEstoque {
  COMPRA
  USO_ATIVIDADE
  AJUSTE
  OUTRO
}

model MovimentacaoEstoque {
  id            String   @id @default(uuid())
  insumoId      String
  insumo        Insumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  tipo          TipoMovimentacaoEstoque
  origem        OrigemMovimentacaoEstoque @default(OUTRO)
  quantidade    Float
  data          DateTime
  observacoes   String?
  // de qual lote saiu/entrou - base do custo real
  loteId        String?
  lote          LoteInsumo? @relation(fields: [loteId], references: [id])
  custoUnitario Float?
  custoTotal    Float?
  atividadeId   String?
  atividade     Atividade? @relation(fields: [atividadeId], references: [id])
  propriedadeId String
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([propriedadeId])
  @@index([insumoId])
  @@index([loteId])
}

// ---------------------------------------------------------------------------
// Controle de pragas: regras que disparam alerta quando um talhao passa muito
// tempo sem receber determinada funcao de produto.
// ---------------------------------------------------------------------------

enum EscopoAlerta {
  TODOS_TALHOES
  GRUPO
  TALHAO
}

model RegraAlerta {
  id            String   @id @default(uuid())
  nome          String
  funcao        FuncaoInsumo
  intervaloDias Int
  escopo        EscopoAlerta @default(TODOS_TALHOES)
  grupoId       String?
  talhaoId      String?
  ativo         Boolean  @default(true)
  observacoes   String?
  propriedadeId String
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([propriedadeId])
}

// ---------------------------------------------------------------------------
// Manejo hidrico: registro de irrigacao por setor
// ---------------------------------------------------------------------------

model Irrigacao {
  id            String   @id @default(uuid())
  clientId      String?  @unique
  setorId       String
  setor         SetorIrrigacao @relation(fields: [setorId], references: [id], onDelete: Cascade)
  data          DateTime
  duracaoHoras  Float?
  laminaMm      Float?
  observacoes   String?
  origem        OrigemLancamento @default(WEB)
  responsavelId String?
  responsavel   Usuario? @relation("IrrigacaoResponsavel", fields: [responsavelId], references: [id])
  propriedadeId String
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([propriedadeId])
  @@index([setorId])
  @@index([data])
}

// ---------------------------------------------------------------------------
// Colheita
// ---------------------------------------------------------------------------

// Colheita em dois momentos:
//  1) campo (encarregado, diario) -> caixas, talhao, quem colheu, R$/caixa
//  2) escritorio (gestor, depois)  -> peso colhido, refugo e valor de venda
// Varios lancamentos no mesmo dia, em talhoes e com empreiteiros diferentes,
// sao linhas separadas.
model Colheita {
  id             String   @id @default(uuid())
  clientId       String?  @unique
  talhaoId       String
  talhao         Talhao   @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  safraId        String?
  safra          Safra?   @relation(fields: [safraId], references: [id])
  data           DateTime

  // --- lancamento de campo ---
  quantidadeCaixas Float
  executorId       String?
  executor         Executor? @relation(fields: [executorId], references: [id])
  valorPorCaixa    Float?
  custoColheita    Float?
  origem           OrigemLancamento @default(WEB)

  // --- complemento comercial (preenchido depois) ---
  pesoTotalKg     Float?
  pesoRefugoKg    Float?

  // Preco pago por CAIXA PADRAO (27,2 kg), separado por qualidade. A receita
  // nao e digitada: o sistema converte o preco da caixa em preco do quilo e
  // multiplica pelos quilos de cada qualidade. Ver PESO_CAIXA_PADRAO_KG em
  // apps/api/src/routes/colheitas.routes.ts.
  precoCaixaBom    Float?
  precoCaixaRefugo Float?

  // Venda em valor fechado, como era lancado antes de existirem os precos por
  // qualidade. Mantido para nao perder o historico: quando os precos acima
  // estao preenchidos, eles mandam; senao, vale este.
  valorTotalVenda Float?

  classificacao  String?
  observacoes    String?
  propriedadeId  String
  propriedade    Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([propriedadeId])
  @@index([talhaoId])
  @@index([data])
  @@index([executorId])
}

// ---------------------------------------------------------------------------
// Analises de solo / folha e perfis de correcao (banco de conhecimento)
// ---------------------------------------------------------------------------

model PerfilCorrecaoSolo {
  id                    String   @id @default(uuid())
  nome                  String
  culturaId             String
  cultura               Cultura  @relation(fields: [culturaId], references: [id], onDelete: Cascade)
  phIdealMin            Float?
  phIdealMax            Float?
  materiaOrganicaIdeal  Float?
  fosforoIdeal          Float?
  potassioIdeal         Float?
  calcioIdeal           Float?
  magnesioIdeal         Float?
  saturacaoBasesIdeal   Float?
  ctcReferencia         Float?
  micronutrientesIdeais Json?
  observacoes           String?
  propriedadeId         String
  propriedade           Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt              DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([propriedadeId])
  @@index([culturaId])
}

model AnaliseSolo {
  id               String   @id @default(uuid())
  talhaoId         String
  talhao           Talhao   @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  dataColeta       DateTime
  profundidadeCm   Float?
  laboratorio      String?
  ph               Float?
  materiaOrganica  Float?
  fosforo          Float?
  potassio         Float?
  calcio           Float?
  magnesio         Float?
  aluminio         Float?
  hAl              Float?
  somaBases        Float?
  ctc              Float?
  saturacaoBases   Float?
  micronutrientes  Json?
  observacoes      String?
  propriedadeId    String
  propriedade      Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([propriedadeId])
  @@index([talhaoId])
  @@index([dataColeta])
}

model AnaliseFoliar {
  id                 String   @id @default(uuid())
  talhaoId           String
  talhao             Talhao   @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  dataColeta         DateTime
  estadioFenologico  String?
  nitrogenio         Float?
  fosforo            Float?
  potassio           Float?
  calcio             Float?
  magnesio           Float?
  enxofre            Float?
  micronutrientes    Json?
  observacoes        String?
  propriedadeId      String
  propriedade        Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([propriedadeId])
  @@index([talhaoId])
  @@index([dataColeta])
}

// ---------------------------------------------------------------------------
// Entrada de estoque por NF-e
//
// So leitura do XML: nada e emitido, transmitido ou escriturado. A nota segue
// o fluxo normal dela com o contador. O que fazemos aqui e gerencial - virar
// lote de estoque com custo real, que depois alimenta o custo por talhao.
// ---------------------------------------------------------------------------

enum OrigemNota {
  ANEXO_MANUAL
  EMAIL
}

enum SituacaoNota {
  /// Lida, aguardando conferencia. Nao mexeu no estoque ainda.
  PENDENTE
  /// Conferida e confirmada: os lotes existem.
  IMPORTADA
  /// Nao interessa (nota de outro assunto, chegou por engano, foi cancelada).
  IGNORADA
}

model NotaFiscalEntrada {
  id          String   @id @default(uuid())
  /// 44 digitos. Unica por definicao - e o que impede importar duas vezes e
  /// dobrar o estoque em silencio.
  chaveAcesso String   @unique
  numero      String
  serie       String
  dataEmissao DateTime

  cnpjEmitente String
  nomeEmitente String

  /// Para quem a nota foi emitida. A mesma caixa de e-mail recebe notas de
  /// mais de uma pessoa juridica da familia, e so as da propriedade devem
  /// virar estoque. CNPJ ou CPF - produtor rural pode receber como pessoa
  /// fisica.
  documentoDestinatario String?
  nomeDestinatario      String?

  valorTotal Float
  /// XML guardado inteiro: permite reprocessar se a leitura melhorar, e serve
  /// de prova do que foi lido. Sao poucos KB por nota.
  xmlOriginal String

  origem   OrigemNota   @default(ANEXO_MANUAL)
  situacao SituacaoNota @default(PENDENTE)

  importadaEm    DateTime?
  importadaPorId String?
  importadaPor   Usuario?  @relation("NotaImportadaPor", fields: [importadaPorId], references: [id])
  observacoes    String?

  propriedadeId String
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  lotes LoteInsumo[]

  @@index([propriedadeId, situacao])
  @@index([cnpjEmitente])
  @@index([dataEmissao])
}

/// O que o sistema aprende sobre o catalogo de cada fornecedor.
///
/// A nota diz "ZAPP QI 620 20 L BRA", codigo 462, unidade BD. O cadastro diz
/// "Zapp QI", controlado em litros. Na primeira nota da Frutagro voce aponta a
/// correspondencia e diz que cada BD tem 20 L; da segunda em diante os 3 BD
/// viram 60 L sozinhos.
///
/// Sem o fator, o custo por talhao erra por um fator de 20.
model MapeamentoProdutoNota {
  id            String @id @default(uuid())
  cnpjEmitente  String
  codigoProduto String
  /// Ultima descricao vista na nota, so para a tela mostrar o que e.
  descricaoNota String
  /// Unidade como o fornecedor vende (BD, CX, SC...).
  unidadeNota String

  insumoId String
  insumo   Insumo @relation(fields: [insumoId], references: [id], onDelete: Cascade)

  /// quantidade da nota x fator = quantidade na unidade do nosso cadastro.
  /// 1 BD de 20 litros -> fator 20.
  fatorConversao Float @default(1)

  propriedadeId String
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([propriedadeId, cnpjEmitente, codigoProduto])
  @@index([insumoId])
}

/// Tipo do laudo de laboratorio, detectado a partir do proprio arquivo.
/// Ver services/analiseLaudo.ts - sao cinco layouts diferentes.
enum TipoLaudo {
  /// Fertilidade do solo: pH, M.O., P, K, Ca, Mg, CTC, V%...
  QUIMICA
  /// Granulometria: argila, silte, areia. Nao muda com o tempo.
  FISICA
  /// Micronutrientes do solo: B, Cu, Fe, Mn, Zn.
  MICRO
  /// Tecido vegetal (folha): N, P, K, Ca, Mg, S, B, Cu, Fe, Mn, Zn, Si.
  FOLIAR
  /// Composto ou esterco produzido na propriedade: %MO, %CO, %N, %P2O5...
  ORGANICO
}

/// Mesmo ciclo das notas fiscais: chega, e conferido, so entao vale.
enum SituacaoLaudo {
  /// Lido, aguardando conferencia. Nao gravou analise nenhuma ainda.
  PENDENTE
  /// Conferido e confirmado: as analises existem nos talhoes/lotes.
  IMPORTADO
  /// Nao interessa (laudo de outra propriedade, duplicado, veio por engano).
  IGNORADO
}

/// Arquivo de laudo enviado pelo usuario.
///
/// Um arquivo traz VARIAS amostras - o laudo de marco/2022 tem 4. Por isso a
/// fila de conferencia lista amostras (AmostraLaudo), nao arquivos.
model LaudoImportado {
  id            String        @id @default(uuid())
  nomeArquivo   String
  tipo          TipoLaudo
  situacao      SituacaoLaudo @default(PENDENTE)

  /// Nome do laboratorio/cliente como veio no cabecalho, so para conferencia.
  cliente     String?
  material    String?
  /// Data de recebimento da amostra pelo laboratorio - a mais proxima da
  /// coleta que o laudo informa. O usuario pode corrigir na conferencia.
  dataColeta  DateTime?

  /// true quando veio de PDF: os valores NAO foram extraidos, so o texto, e o
  /// usuario digita olhando o laudo. Extrair numero de PDF de laboratorio
  /// junta valores ("23,7512,21" sao dois) e quebra numero entre linhas.
  digitacaoManual Boolean @default(false)
  /// Texto cru do PDF, mostrado ao lado dos campos para o usuario copiar.
  textoExtraido   String?

  importadoEm    DateTime?
  importadoPorId String?
  importadoPor   Usuario?  @relation("LaudoImportadoPor", fields: [importadoPorId], references: [id])
  observacoes    String?

  propriedadeId String
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  amostras AmostraLaudo[]

  @@index([propriedadeId, situacao])
  @@index([tipo])
}

/// Uma amostra dentro do laudo - e o que o usuario confere e referencia.
model AmostraLaudo {
  id      String         @id @default(uuid())
  laudoId String
  laudo   LaudoImportado @relation(fields: [laudoId], references: [id], onDelete: Cascade)

  /// Codigo do laboratorio, ex "S26/89869".
  codigoLaboratorio String?
  /// Como o produtor identificou na coleta: "LIMAO NOVO", "SACOLA AMARELA".
  /// E o que permite sugerir o talhao - mas a confirmacao e sempre do usuario.
  identificacao     String?
  profundidade      String?

  /// Valores lidos, ja conferidos/corrigidos pelo usuario.
  /// Json porque as chaves mudam por tipo de laudo (a fisica tem argila e
  /// areia; a foliar tem N e Si) e criar coluna para cada uma multiplicaria
  /// colunas nulas sem ganho - a conta que usa isso le pela chave.
  valores Json

  /// Colunas com numero que o leitor nao soube nomear. Aparecem na conferencia
  /// em vez de sumirem: laudo novo com coluna nova fica visivel.
  naoReconhecidas String[]

  /// Onde esta amostra foi parar depois de confirmada. Nulo enquanto pendente,
  /// e continua nulo se o usuario decidir arquivar.
  talhaoId String?
  talhao   Talhao? @relation(fields: [talhaoId], references: [id], onDelete: SetNull)
  loteCompostoId String?
  loteComposto   LoteComposto? @relation(fields: [loteCompostoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([laudoId])
  @@index([talhaoId])
  @@index([loteCompostoId])
}

/// Fisica do solo do talhao.
///
/// Separada da analise quimica de proposito: granulometria NAO muda de ano
/// para ano. Uma vez medida, vale para sempre naquele talhao - mas fica
/// aberta a atualizacao, porque o produtor pode reamostrar ou corrigir.
/// E entrada de calculo de adubacao, por isso tem coluna propria em vez de
/// Json: argila entra em conta, e Json nao entra em conta nem em filtro.
model AnaliseFisicaSolo {
  id       String @id @default(uuid())
  talhaoId String
  talhao   Talhao @relation(fields: [talhaoId], references: [id], onDelete: Cascade)

  dataColeta     DateTime
  profundidadeCm String?
  laboratorio    String?

  /// Percentuais da granulometria.
  argila     Float?
  silte      Float?
  areiaTotal Float?

  /// Fracoes da areia, tambem em percentual.
  areiaMuitoGrossa Float?
  areiaGrossa      Float?
  areiaMedia       Float?
  areiaFina        Float?
  areiaMuitoFina   Float?

  argilaDispersaAgua Float?
  grauFloculacao     Float?
  grauDispersao      Float?

  observacoes   String?
  propriedadeId String
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([propriedadeId])
  @@index([talhaoId])
}

/// Lote de composto ou esterco produzido na propriedade.
///
/// Dois caminhos, conforme a decisao do produtor:
///   - vira INSUMO no estoque (insumoId preenchido): a partir dai a aplicacao
///     no pomar segue o mesmo caminho de qualquer adubacao, sem nada novo
///   - fica so como registro (insumoId nulo): a analise existe, mas nada e
///     lancado no estoque nem em talhao nenhum
model LoteComposto {
  id            String   @id @default(uuid())
  nome          String
  dataProducao  DateTime?
  origem        String?
  observacoes   String?

  /// Preenchido quando o lote foi levado ao estoque.
  insumoId String?
  insumo   Insumo? @relation(fields: [insumoId], references: [id], onDelete: SetNull)

  propriedadeId String
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  analises AnaliseComposto[]
  amostras AmostraLaudo[]

  @@index([propriedadeId])
  @@index([insumoId])
}

/// Analise de composto/esterco. Unidades em percentual, nao em mmolc/dm3:
/// e material solido concentrado, nao solo.
model AnaliseComposto {
  id     String       @id @default(uuid())
  loteId String
  lote   LoteComposto @relation(fields: [loteId], references: [id], onDelete: Cascade)

  dataColeta  DateTime
  laboratorio String?

  materiaOrganica  Float?
  carbonoOrganico  Float?
  nitrogenio       Float?
  p2o5Total        Float?
  k2o              Float?
  calcio           Float?
  magnesio         Float?
  enxofre          Float?
  ph               Float?
  umidade          Float?
  relacaoCN        Float?
  micronutrientes  Json?

  observacoes   String?
  propriedadeId String
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([propriedadeId])
  @@index([loteId])
}

/// Leitura mensal de vigor por satelite, guardada no banco.
///
/// Antes, o Manejo Nutricional e a aba Satelite do talhao chamavam o
/// Copernicus AO VIVO toda vez que a tela abria - sete requisicoes so para
/// ver uma pagina, para um numero que so muda de mes em mes. Nunca ameacaria
/// a cota gratuita (fracao de 1%), mas era espera e processamento a toa.
///
/// Agora existe uma sincronizacao (POST /satelite/sincronizar, ver
/// services/sincronizacaoSatelite.ts) que busca a leitura recente de cada
/// talhao e grava aqui. As telas passam a so ler o banco.
model LeituraSatelite {
  id            String      @id @default(uuid())
  talhaoId      String
  talhao        Talhao      @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  propriedadeId String
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)

  /// Primeiro dia do mes que esta leitura representa (sempre UTC, meia-noite).
  /// Chave de deduplicacao: rodar a sincronizacao duas vezes no mesmo mes nao
  /// gera duas linhas nem gasta cota do Copernicus de novo.
  periodo DateTime

  ndviMedio  Float?
  osaviMedio Float?
  desvio     Float?
  pixels     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([talhaoId, periodo])
  @@index([propriedadeId])
  @@index([talhaoId])
}
