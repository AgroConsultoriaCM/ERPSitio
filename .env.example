# Banco de dados
POSTGRES_USER=erpsitio
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=erpsitio
POSTGRES_PORT=5432
DATABASE_URL=postgresql://erpsitio:troque-esta-senha@db:5432/erpsitio?schema=public

# API
API_PORT=3333
JWT_SECRET=troque-este-segredo-por-uma-string-longa-e-aleatoria
JWT_REFRESH_SECRET=troque-este-outro-segredo-tambem-longo-e-aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:5173

# Web
WEB_PORT=5173
VITE_API_URL=http://localhost:3333/api/v1

# Seed inicial (usuario admin)
SEED_ADMIN_EMAIL=admin@sitio.com.br
SEED_ADMIN_SENHA=troque-esta-senha-123

# ---------------------------------------------------------------------------
# Producao dividida (frontend na Vercel, API + banco na Oracle)
# Ver infra/oracle/README-micro.md. Nada abaixo e usado no desenvolvimento.
# ---------------------------------------------------------------------------

# Dominio so da API. O site fica no dominio raiz, servido pela Vercel.
DOMINIO_API=api.sitiocostamello.com.br
EMAIL_TLS=voce@exemplo.com

# Quem pode chamar a API pelo navegador. Separe por virgula, sem barra no fim.
# Precisa bater exatamente com o endereco do site, inclusive o https://.
# CORS_ORIGIN=https://sitiocostamello.com.br,https://www.sitiocostamello.com.br

# Imagem publicada pelo GitHub Actions. So mude para fixar uma versao antiga.
# IMAGEM_API=ghcr.io/agroconsultoriacm/erpsitio-api:main

# API Agrofit (AgroAPI da Embrapa) - consulta ao cadastro oficial do MAPA.
# Plano Gratuito100KPorMes: 100 mil requisicoes por mes, sem custo.
# As duas chaves saem de agroapi.cnptia.embrapa.br -> Applications -> AgroFIT
# -> Production Keys -> Show Keys. Sem elas o sistema roda igual; so a consulta
# de registro fica indisponivel.
# AGROFIT_CONSUMER_KEY=
# AGROFIT_CONSUMER_SECRET=

# Copernicus Data Space (Sentinel Hub) - NDVI por talhao a partir do Sentinel-2.
# Conta gratuita: 10.000 processing units e 10.000 requisicoes por mes. O uso do
# sitio fica em fracao de 1% disso.
# As duas saem de dataspace.copernicus.eu -> User Settings -> OAuth clients.
# COPERNICUS_CLIENT_ID=
# COPERNICUS_CLIENT_SECRET=

# Caixa que recebe as NF-e dos fornecedores (encaminhadas por filtro do
# Gmail). EMAIL_NOTAS_SENHA e uma SENHA DE APP (16 caracteres, gerada em
# myaccount.google.com/apppasswords, com a verificacao em duas etapas ativada
# na conta) - nunca a senha normal de login. Sem elas, a leitura automatica
# da caixa fica desligada e as notas so entram pela tela (anexar XML a mao).
# EMAIL_NOTAS_USUARIO=sitiocostamello@gmail.com
# EMAIL_NOTAS_SENHA=

# Web Push (avisos no celular do encarregado). Gere com
# `npx web-push generate-vapid-keys`. Sem elas, o envio de aviso vira
# no-op silencioso - o resto do sistema funciona igual.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:voce@exemplo.com

# Copia do backup fora da maquina (rclone + Google Drive)
# RCLONE_DESTINO=drive:ERPSitio/backups
# SENHA_BACKUP=uma-senha-longa-so-para-o-backup
# Sem esta senha o backup nao abre. Guarde no gerenciador de senhas E no papel.
# DIAS_RETENCAO=30
# DIAS_RETENCAO_NUVEM=180
